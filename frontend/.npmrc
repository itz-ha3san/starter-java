# .npmrc — استفاده از mirror داخلی npm برای دسترسی بهتر از ایران
# این فایل توسط npm به‌صورت خودکار خوانده می‌شود (در هر دو حالت محلی و Docker
# اگر COPY شود). برای Docker، Dockerfile مربوط به frontend این تنظیمات را
# در زمان build با `npm config set` اعمال می‌کند، ولی این فایل هم برای
# اجرای محلی (`npm install` / `npm test` درست کار کند) مفید است.
registry=https://registry.npmmirror.com
strict-ssl=false

# اگر peer dependency خطا داد، این گزینه آن را نادیده می‌گیرد.
legacy-peer-deps=true

# جلوگیری از telemetry و fund پیام‌ها
fund=false
audit=false
