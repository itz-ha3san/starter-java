# ──────────────────────────────────────────────
# LabBank S3 Payment Service — environment template
# Copy to .env and adjust. Never commit secrets (GEN-12).
# ──────────────────────────────────────────────

# Application
APP_PORT=8083

# PostgreSQL (GEN-12: independent DB per service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paymentdb
DB_USER=postgres
DB_PASSWORD=postgres

# Kafka (ADR-0001: inter-service communication)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Frontend
FRONTEND_PORT=3000

# Swagger UI (AsyncAPI Studio alternative for OpenAPI)
# Accessible at http://localhost:8088 after `docker compose up`
