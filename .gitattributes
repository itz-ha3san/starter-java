# Store detected text files with LF on every platform.
* text=auto eol=lf

# Explicit text formats used by the service and its tooling.
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.bru text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.go text eol=lf
*.py text eol=lf
*.cs text eol=lf

# Binary assets must not receive line-ending conversions or text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
*.class binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
